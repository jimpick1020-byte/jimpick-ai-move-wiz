# 이 파일을 secrets.toml 로 복사한 뒤 실제 값을 넣어주세요.
# (secrets.toml 은 .gitignore 에 등록되어 깃에 올라가지 않습니다.)

# --- AI 글쓰기 (Google Gemini) ---
# Google AI Studio(https://aistudio.google.com/apikey)에서 키를 발급받을 수 있습니다.
GEMINI_API_KEY = "여기에_발급받은_키를_넣으세요"

# --- 네이버 블로그 발행 ---
# 네이버 개발자센터(https://developers.naver.com)에서 앱을 등록하고,
# "네이버 로그인" + "블로그" API 권한을 추가한 뒤 값을 넣어주세요.
NAVER_CLIENT_ID = "네이버_앱_Client_ID"
NAVER_CLIENT_SECRET = "네이버_앱_Client_Secret"
# 네이버 앱에 등록한 Callback URL 과 정확히 같아야 합니다.
NAVER_REDIRECT_URI = "http://localhost:8501"
