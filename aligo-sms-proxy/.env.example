# ── 알리고 ────────────────────────────────────────────────
# 알리고 > 문자 API 에서 발급
ALIGO_API_KEY=
# 알리고 로그인 아이디
ALIGO_USER_ID=
# 사전등록을 마친 발신번호 (예: 010-7566-2542)
ALIGO_SENDER=

# ── 이 서버를 부를 때 쓰는 비밀키 ─────────────────────────
# Supabase Edge Function 과 똑같은 값을 넣습니다.
# 아무 문자열이나 되지만 40자 이상 무작위를 권합니다.
JIMPICK_PROXY_SECRET=

# ── 발송 결과 기록용 ──────────────────────────────────────
# Supabase > 프로젝트 설정 > API 에서 확인
SUPABASE_URL=
# service_role 키 — 절대 앱·브라우저에 넣지 마세요
SUPABASE_SERVICE_ROLE_KEY=
