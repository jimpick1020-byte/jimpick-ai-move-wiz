# ── 알리고 ────────────────────────────────────────────────
# 알리고 > 문자 API 에서 발급
ALIGO_API_KEY=
# 알리고 로그인 아이디
ALIGO_USER_ID=
# 발신번호는 업체별 사전 승인 기록에서 조회합니다. 전역 번호를 사용하지 않습니다.

# ── 이 서버를 부를 때 쓰는 비밀키 ─────────────────────────
# Supabase Edge Function 과 똑같은 값을 넣습니다.
# 아무 문자열이나 되지만 40자 이상 무작위를 권합니다.
JIMPICK_PROXY_SECRET=

# ── 발송 결과 기록용 ──────────────────────────────────────
# 서버에 발신번호 승인 기록 조회 권한이 필요합니다. 비밀값은 안전한 서버 저장소에만 보관합니다.
SUPABASE_URL=
# 서버 전용 자격정보 — 절대 앱·브라우저에 넣지 마세요
SUPABASE_SERVICE_ROLE_KEY=
