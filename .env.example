# ── 문자 발송 (알리고 Aligo) ─────────────────────────────
# https://smartsms.aligo.in → 문자 API → API Key 발급
# 서버에서만 읽습니다. 브라우저·화면에는 나가지 않습니다.
ALIGO_API_KEY=
# 알리고 로그인 아이디
ALIGO_USER_ID=
# 사전등록을 마친 발신번호 (예: 010-7566-2542)
ALIGO_SENDER=
# 시험만 하고 실제로 보내지 않으려면 Y (요금이 나가지 않습니다)
ALIGO_TEST_MODE=N

# ── 카카오 ────────────────────────────────────────────────
# 지도 표시용 JavaScript 키
KAKAO_MAP_JS_KEY=
# 주소 검색·길찾기용 REST API 키 (거리·시간 계산에 필요)
KAKAO_REST_API_KEY=

# ── AI ────────────────────────────────────────────────────
# 사진·음성 인식용
LOVABLE_API_KEY=
